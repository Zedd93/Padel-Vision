# === PadelVision - konfiguracja produkcyjna (serwer firmowy) ===
#
# Docelowo: C:\padelvision\.env.production
# Backend czyta ten plik jako .properties: KLUCZ=wartosc, bez cudzyslowow.
# NIE commituj wypelnionej wersji - .gitignore blokuje .env.production.
#
# Ta linia i powyzsze musza zostac komentarzem: gdyby edytor dopisal
# znacznik BOM na poczatku pliku, zepsuje komentarz, a nie pierwszy klucz.
# Instrukcja: docs/DEPLOY.md

# --- Baza danych (PostgreSQL na tym serwerze) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/padelvision
DATABASE_USERNAME=padelvision
DATABASE_PASSWORD=

# --- Redis (w WSL Ubuntu22) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- JWT - co najmniej 64 znaki, inaczej HS512 odrzuci klucz ---
JWT_SECRET=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# --- CORS - frontend na Vercelu ---
ALLOWED_ORIGINS=https://padelvision.tv,https://www.padelvision.tv

# --- YouTube Live (docs/YOUTUBE_SETUP.md) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.padelvision.tv/api/club/youtube/callback
# Ten sam klucz co lokalnie - inaczej zapisane polaczenia klubow nie dadza sie odczytac
YOUTUBE_TOKEN_ENC_KEY=
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_DEFAULT_LATENCY=low
YOUTUBE_POST_CONNECT_REDIRECT=https://padelvision.tv/studio

# --- Stripe (opcjonalne - puste wylacza platnosci) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- S3 na loga i awatary klubow (opcjonalne) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=padelvision-media
AWS_REGION=eu-central-1
