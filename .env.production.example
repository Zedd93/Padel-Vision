# ─── PadelVision — produkcja (droplet DigitalOcean) ──────────────
#
# Cała zawartość tego pliku (po uzupełnieniu) trafia do JEDNEGO sekretu
# GitHuba o nazwie ENV_PRODUCTION. Instrukcja: docs/DEPLOY.md
#
# NIE commituj wypełnionej wersji. .gitignore blokuje .env.production.
# ──────────────────────────────────────────────────────────────────

# ─── Domena API (Caddy pobierze dla niej certyfikat HTTPS) ────────
API_DOMAIN=api.padelvision.tv

# ─── Baza danych ──────────────────────────────────────────────────
POSTGRES_USER=padelvision
POSTGRES_DB=padelvision
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────
# HS512 wymaga min. 64 znaków — openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ─── CORS — adres frontendu na Vercelu ────────────────────────────
ALLOWED_ORIGINS=https://padelvision.tv,https://www.padelvision.tv

# ─── YouTube Live (docs/YOUTUBE_SETUP.md) ─────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.padelvision.tv/api/club/youtube/callback
# Ten sam klucz co lokalnie — inaczej zapisane tokeny klubów nie dadzą się odczytać
YOUTUBE_TOKEN_ENC_KEY=
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_DEFAULT_LATENCY=low
YOUTUBE_POST_CONNECT_REDIRECT=https://padelvision.tv/studio

# ─── Stripe (opcjonalne — puste wyłącza płatności) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ─── S3 na loga i awatary klubów (opcjonalne) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=padelvision-media
AWS_REGION=eu-central-1
