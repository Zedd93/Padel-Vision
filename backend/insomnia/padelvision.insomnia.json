    {
      "_id": "ut_health",
      "_type": "unit_test",
      "parentId": "uts_smoke",
      "name": "Health endpoint returns 200 OK with status field",
      "requestId": "req_health",
      "code": "const response = await insomnia.send();\nexpect(response.status).to.equal(200);\nconst body = JSON.parse(response.data);\nconst payload = body.data !== undefined ? body.data : body;\nexpect(payload).to.have.property('status');\n"
    },
    {
      "_id": "ut_register",
      "_type": "unit_test",
      "parentId": "uts_smoke",
      "name": "Register new user returns 200 with accessToken + refreshToken",
      "requestId": "req_auth_register",
      "code": "const response = await insomnia.send();\nexpect(response.status).to.be.oneOf([200, 201, 409]);\nconst body = JSON.parse(response.data);\nconst payload = body.data !== undefined ? body.data : body;\nif (response.status !== 409) {\n  expect(payload).to.have.property('accessToken');\n  expect(payload).to.have.property('refreshToken');\n  expect(payload).to.have.property('user');\n  expect(payload.accessToken).to.be.a('string').and.not.empty;\n  expect(payload.refreshToken).to.be.a('string').and.not.empty;\n}"
    },
    {
      "_id": "ut_login",
      "_type": "unit_test",
      "parentId": "uts_smoke",
      "name": "Login with same credentials returns tokens",
      "requestId": "req_auth_login",
      "code": "const response = await insomnia.send();\nexpect(response.status).to.equal(200);\nconst body = JSON.parse(response.data);\nconst payload = body.data !== undefined ? body.data : body;\nexpect(payload).to.have.property('accessToken').that.is.a('string').and.not.empty;\nexpect(payload).to.have.property('refreshToken').that.is.a('string').and.not.empty;\nexpect(payload).to.have.property('user');\nexpect(payload.user).to.have.property('id');\nexpect(payload.user).to.have.property('email');\n"
    },
    {
