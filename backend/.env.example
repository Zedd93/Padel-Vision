# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/padelvision
DATABASE_USERNAME=padelvision
DATABASE_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=changeme-min-256-bit-key-for-hs512-algorithm-padelvision
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_S3_BUCKET=padelvision-media-dev
AWS_REGION=eu-central-1

# Stripe
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_CONNECT_CLIENT_ID=ca_changeme

# YouTube Live — setup: docs/YOUTUBE_SETUP.md
YOUTUBE_CLIENT_ID=changeme.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=changeme
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/club/youtube/callback
# openssl rand -base64 32  — backup obowiązkowy, utrata = ponowny OAuth wszystkich klubów
YOUTUBE_TOKEN_ENC_KEY=changeme
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_DEFAULT_LATENCY=low
YOUTUBE_DAILY_QUOTA_UNITS=10000

# Google OAuth — NIEUŻYWANE (pozostałość po NextAuth, brak kodu w backendzie).
# Do logowania Google, nie do YouTube. YouTube ma własnego klienta powyżej.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
